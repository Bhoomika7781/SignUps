flowchart TB
    %% ===================== CLIENTS =====================
    subgraph CLIENTS["① Clients (src/kvdb)"]
        direction LR
        CLI["<b>CLI</b><br/>open · put · get · del<br/>batch · dump · check · compact"]
        SERVE["<b>serve</b><br/>stdin → ACK id<br/>one goroutine per lane (w0, w1…)<br/>ACK only after Batch() returns nil"]
        EXTRA["<b>shell · web UI</b><br/>(extras, same API)"]
        TORT["<b>torture tool</b><br/>2+ writers · SIGKILL<br/>oracle of SENT / ACKED"]
    end

    TORT -. "start / kill -9" .-> SERVE
    TORT -. "open · check · dump" .-> CLI

    %% ===================== ENGINE API =====================
    API{{"<b>Engine API: src/engine (package engine)</b><br/>Open · Put · Delete · Batch · Get · Compact · Close<br/>one <b>sync.RWMutex</b>: writers Lock (exclusive) · readers RLock (shared)"}}
    CLI --> API
    SERVE --> API
    EXTRA --> API

    %% ===================== ENGINE PARTS =====================
    subgraph ENGINE["② Engine"]
        direction LR

        subgraph WRITE["Write path: db.go Batch()"]
            direction TB
            W1["1 · validateOps + encodeRecord<br/>whole batch → ONE record, ONE CRC-32C<br/><i>(no lock yet)</i>"]
            W2["2 · Lock()"]
            W3["3 · disk-full guard<br/>size + record &gt; max_bytes?<br/>→ compact, or ErrFull (nothing written)"]
            W4["4 · f.WriteAt(record, size)<br/>append at end of last valid record"]
            W5["5 · f.Sync()  ✔ COMMIT POINT"]
            W6["6 · applyOp → index · size += len"]
            W7["7 · Unlock · return nil → ACK"]
            W1 --> W2 --> W3 --> W4 --> W5 --> W6 --> W7
        end

        subgraph READ["Read path: db.go Get()"]
            direction TB
            G1["RLock()"]
            INDEX[("<b>In-memory index</b><br/>map key → {offset, vlen}<br/>+ live / dead counters<br/>RAM only · rebuilt at open")]
            G2["f.ReadAt(value, offset)"]
            G1 --> INDEX --> G2
        end

        subgraph REC["Recovery: db.go Open() + recover.go scanLog()"]
            direction TB
            R1["1 · delete leftover path.compact"]
            R2["2 · open / create file"]
            R3["3 · scan from byte 0 · stop at first<br/>short header · bad magic ·<br/>plen &gt; bytes left · CRC mismatch"]
            R4["4 · apply ops only after CRC passed"]
            R5["5 · Truncate(validEnd) + Sync()<br/>idempotent: safe to crash here"]
            R1 --> R2 --> R3 --> R4 --> R5
        end

        subgraph COMP["Compaction: compact.go compactLocked()"]
            direction TB
            C1["1 · write live keys → path.compact"]
            C2["2 · fsync temp"]
            C3["3 · close temp + old file"]
            C4["4 · os.Rename(temp, path)<br/>✔ COMMIT POINT (atomic)"]
            C5["5 · fsync directory (Linux/macOS)"]
            C6["6 · reopen · swap index"]
            C1 --> C2 --> C3 --> C4 --> C5 --> C6
        end
    end

    API --> W1
    API --> G1
    API --> R1
    API --> C1
    W3 -. "full" .-> C1
    W6 --> INDEX
    R4 --> INDEX
    C6 --> INDEX

    %% ===================== DISK =====================
    subgraph DISK["③ Disk"]
        direction LR
        FILE[("<b>path</b> e.g. my.db: append-only log, no header<br/>[magic 'KVR1' 4B][plen 4B][crc 4B][payload]<br/>payload = [count 4B] + count × [type 1B][klen 4B][vlen 4B][key][value]<br/>little-endian · CRC-32C over plen + payload")]
        TMP[("<b>path.compact</b><br/>exists only during compaction")]
    end

    W4 --> FILE
    W5 --> FILE
    G2 --> FILE
    R3 --> FILE
    C1 --> TMP
    C4 --> FILE

